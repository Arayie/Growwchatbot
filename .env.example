# Environment Configuration Template for SBI Mutual Fund RAG Assistant
# Copy this file to .env and set your environment variables as needed.

APP_NAME="Groww SBI Mutual Fund RAG Assistant"
APP_ENV=production
DEBUG=False
PORT=8000

# SQLite & ChromaDB Paths
SQLITE_DB_PATH=./sbi_scheme_facts.db
CHROMA_DB_PATH=./chroma_db

# Embedding Model Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
MAX_SIMILARITY_SCORE_THRESHOLD=0.85

# Optional LLM API Key Settings (if using external API generation)
# OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
